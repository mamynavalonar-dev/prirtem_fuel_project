# ────────────────── server/.env.example ──────────────────
# Base de données
DATABASE_URL=postgres://USER:PASSWORD@localhost:5432/prirtem_fuel

# Auth
JWT_SECRET=REPLACE_WITH_A_STRONG_RANDOM_SECRET_AT_LEAST_32_CHARS

# Client (pour les liens dans les emails de reset password)
APP_CLIENT_URL=http://localhost:5173
CLIENT_URL=http://localhost:5173

# SMTP (obligatoire en production pour la récupération de mot de passe)
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
SMTP_FROM=no-reply@prirtem.local

# Environnement
NODE_ENV=development
PORT=3001

# ── Mots de passe seed (jamais versionner de vraies valeurs) ──
# Seul l'administrateur est obligatoire. Les autres comptes sont optionnels.
SEED_ADMIN_PASSWORD=CHANGE_ME
SEED_LOGISTIQUE_PASSWORD=
SEED_RAF_PASSWORD=
SEED_DEMANDEUR_PASSWORD=

# ── Garde-fous production (voir seed.js / reset.js) ──
ALLOW_SEED_IN_PROD=false
ALLOW_RESET_IN_PROD=false
CONFIRM_DATABASE_RESET=

# Base de données
DB_SSL=false
DB_POOL_MAX=20
DB_IDLE_TIMEOUT_MS=30000
DB_CONNECTION_TIMEOUT_MS=5000
DB_STATEMENT_TIMEOUT_MS=30000
DB_SSL_REJECT_UNAUTHORIZED=true
# DB_SSL_CA=-----BEGIN CERTIFICATE-----\n...\n-----END CERTIFICATE-----

# ── Debug ──
DEBUG_STACK=false

# Connexion administrative/session pour migrations (Supabase: pooler session 5432).
# Laisser vide en local si DATABASE_URL convient.
MIGRATION_DATABASE_URL=

# Démonstration publique
DEMO_MODE=false
ALLOW_DEMO_SEED=false

# Import Excel (Vercel force au maximum 3 MB / 1 fichier par requête)
IMPORT_MAX_FILE_SIZE_MB=5
IMPORT_MAX_FILES=5
