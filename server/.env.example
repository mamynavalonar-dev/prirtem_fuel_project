# ────────────────── server/.env.example ──────────────────
# Base de données
DATABASE_URL=postgres://USER:PASSWORD@localhost:5432/prirtem_fuel

# Auth
JWT_SECRET=REPLACE_WITH_A_STRONG_RANDOM_SECRET_AT_LEAST_32_CHARS

# Client (pour les liens dans les emails de reset password)
APP_CLIENT_URL=http://localhost:5173
CLIENT_URL=http://localhost:5173

# SMTP (optionnel, sinon mode mock console)
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
SMTP_FROM=no-reply@prirtem.local

# Environnement
NODE_ENV=development
PORT=3001

# ── Mots de passe seed (server/src/sql/seed.js et reset.js) ──
# Utilisés uniquement par `npm run db:seed` / `npm run db:reset`.
SEED_ADMIN_PASSWORD=CHANGE_ME
SEED_LOGISTIQUE_PASSWORD=CHANGE_ME
SEED_RAF_PASSWORD=CHANGE_ME
SEED_DEMANDEUR_PASSWORD=CHANGE_ME

# ── Garde-fous production (voir seed.js / reset.js) ──
ALLOW_SEED_IN_PROD=false
ALLOW_RESET_IN_PROD=false

# ── Debug ──
DEBUG_STACK=false