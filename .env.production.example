# Copiez ce fichier vers .env.production sur le serveur (ne le versionnez pas).
POSTGRES_USER=prirtem
POSTGRES_PASSWORD=GENERATE_A_STRONG_DATABASE_PASSWORD
POSTGRES_DB=prirtem_fuel
DATABASE_URL=postgresql://prirtem:URL_ENCODED_PASSWORD@db:5432/prirtem_fuel
JWT_SECRET=GENERATE_AT_LEAST_32_RANDOM_BYTES
CLIENT_URL=https://fuel.example.org
APP_CLIENT_URL=https://fuel.example.org
APP_PORT=3001
DB_SSL=false

SMTP_HOST=smtp.example.org
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=no-reply@example.org
